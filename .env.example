# Google OAuth "Web application" client (Cloud Console → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# PORT=5173
# BASE_URL=http://localhost:5173
# DATABASE_PATH=data/subpulse.db
# CHANNEL_TTL_HOURS=6          # reuse channel stats synced by anyone within this window
# YOUTUBE_DAILY_QUOTA=10000    # stop syncing when this many API units were used today
# ENCRYPTION_KEY=              # 32 bytes base64; auto-generated into data/ if empty
